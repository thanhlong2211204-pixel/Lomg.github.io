_type\":19,\"ss_target_pool_cluster_id\":50005,\"ss3_app_id\":19,\"ss3_baf_key_str\":\"prism_v1_photo\",\"mf_objid\":\"1459411319335756\",\"ent_attachement_type\":\"MediaAttachment\",\"viewstate_id\":\"-884056680901370295\",\"pos\":3,\"should_log_for_ranking_full\":131072,\"page_insights\":{\"100058007051542\":{\"page_id\":\"100058007051542\",\"page_id_type\":\"page\",\"actor_id\":\"100058007051542\",\"dm\":{\"isShare\":0,\"originalPostOwnerID\":0,\"sharedMediaID\":0,\"sharedMediaOwnerID\":0},\"psn\":\"EntPhotoUploadBatchNodeBasedEdgeStory\",\"post_context\":{\"object_fbtype\":22,\"publish_time\":1790584532,\"story_name\":\"EntPhotoUploadBatchNodeBasedEdgeStory\",\"story_fbid\":[\"1459411272669094\"]},\"role\":1,\"sl\":5}},\"profile_relationship_type\":6,\"recommendation_item_source\":11054,\"recommendation_item_trigger_source\":874477,\"partial_response_callsite_id\":-1,\"actrs\":\"100058007051542\",\"is_creator_profile_plus\":\"1\",\"join_key_from_recagg\":\"J118,100014580642284,-6078060832160520558,1459411319335756,IFR,S3\",\"is_affiliate_post\":\"1\",\"feed_unified_request_id\":\"-6078060419806194668\",\"fb_reels_unified_request_id\":\"-6078060419956182070\",\"tds_flgs\":3}","th_dat_spo":null,"inform_treatment_for_messaging":null,"target_group":null,"click_tracking_linkshim_cb":"AUDcLw9alq4lNh43hSzTtc22lHaPL1uJYkhz1Dqpsw9VMmGbcF89NmgLeKJG-joe80vkwL-hGUGIwaWdEmYD-k1xZ4K5Rhgt5c4tBeWJ7YU6fWwbLxswbNFvpAzQM5lCNpLSQrldQYtH9XQ6RrJFxIcfLY89Q1jfKUSy9yXrFzuZhYcf0CtC7is_U3jJY7qMtLm-iqe_e7vrAQPUZuZcfXHVIoCepMVAmJBk_DV_3GHP","encrypted_click_tracking":"AZjDhlfXxkWBYF5cGIC-NKRSHjSjn6lEWWy80CxiTaUwv_xBcmslpfkbEVae4-eW2pMmnr_IXWtd980Ju1wwN1VmXlreksXqKBOV3nzaNwc_QTLxWbwPNhMvZ7dP__6lGbnDgtcHoxuDL3p_l0pF-Pk_aq-TlSBU3c6B91OQfANH-YPR2uwcQYbldHPggjs7_DyUiPtp_GEnBA","seo_title":"\ud83c\udde7\ud83c\uddf7 ZKRAKEN V\u00c0 C\u00c1I T\u00caN \u0110\u1eb6C BI\u1ec6T D\u00c0NH CHO HIMASS \ud83d\udc9a\ud83d\udc9b","message":{"text":"\ud83c\udde7\ud83c\uddf7 ZKRAKEN V\u00c0 C\u00c1I T\u00caN \u0110\u1eb6C BI\u1ec6T D\u00c0NH CHO HIMASS \ud83d\udc9a\ud83d\udc9b\n\nKh\u00f4ng c\u1ea7n m\u1ed9t b\u00e0i \u0111\u0103ng d\u00e0i, tuy\u1ec3n th\u1ee7 PUBG Brazil zkrakeN, nh\u00e0 v\u00f4 \u0111\u1ecbch Nations Cup 2026, ch\u1ec9 \u0111\u01a1n gi\u1ea3n \u0111\u1ed5i t\u00ean th\u00e0nh \u201cHimassPJL\u201d.\n\nNh\u01b0ng 4 ch\u1eef c\u00e1i ph\u00eda sau l\u1ea1i kh\u00f4ng h\u1ec1 ng\u1eabu nhi\u00ean.\nPJL l\u00e0 vi\u1ebft t\u1eaft c\u1ee7a Paz, Justica e Liberdade ngh\u0129a l\u00e0 H\u00d2A B\u00ccNH- C\u00d4NG L\u00dd - T\u1ef0 DO trong ti\u1ebfng B\u1ed3 \u0110\u00e0o Nha.\n\nM\u1ed9t c\u00e1i t\u00ean m\u1edbi, m\u1ed9t c\u00e1ch th\u1ec3 hi\u1ec7n r\u1ea5t ri\u00eang. zkrakeN d\u00f9ng ch\u00ednh nickname c\u1ee7a m\u00ecnh \u0111\u1ec3 g\u1eedi th\u00f4ng \u0111i\u1ec7p \u1ee7ng h\u1ed9 Himass, \u0111\u1ed3ng th\u1eddi nh\u1eafc \u0111\u1ebfn nh\u1eefng \u0111i\u1ec1u m\u00e0 anh mu\u1ed1n h\u01b0\u1edbng t\u1edbi: h\u00f2a b\u00ecnh, c\u00f4ng l\u00fd v\u00e0 t\u1ef1 do.\n\n\u0110\u00f4i khi, s\u1ef1 \u1ee7ng h\u1ed9 kh\u00f4ng c\u1ea7n qu\u00e1 nhi\u1ec1u l\u1eddi. Ch\u1ec9 m\u1ed9t l\u1ea7n \u0111\u1ed5i t\u00ean c\u0169ng \u0111\u1ee7 \u0111\u1ec3 ng\u01b0\u1eddi kh\u00e1c hi\u1ec3u b\u1ea1n \u0111ang \u0111\u1ee9ng \u1edf \u0111\u00e2u. \ud83d\udc9a\ud83d\udc9b"},"save_info":{"viewer_save_state":"NOT_SAVED","savable":{"__typename":"Photo","savable_title":{"text":"\u1ea2nh c\u1ee7a C\u1ea3m B\u00f3ng \u0110\u00e1"},"id":"1459411272669094"},"save_flow":{"__typename":"SaveSelectCollectionSaveFlow","collection_candidates":{"preselected":"674991002996915"}}},"actors":[{"__typename":"User","name":"C\u1ea3m B\u00f3ng \u0110\u00e1","id":"100058007051542"}],"__module_operation_useCometUFIAdaptivePostActionBar_story":{"__dr":"CometUFIAdaptiveShareActionRenderer_story$normalization.graphql"},"__module_component_useCometUFIAdaptivePostActionBar_story":{"__dr":"CometUFIAdaptiveShareActionRenderer.react"},"vote_attachments":[],"feed_backend_data":{"pcomment"