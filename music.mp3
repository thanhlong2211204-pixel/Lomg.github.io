tion_story":{"target_group":null,"id":"UzpfSTEwMDA1ODAwNzA1MTU0MjoxNDU5NDExMzE5MzM1NzU2OjE0NTk0MTEzMTkzMzU3NTY="}}},"__module_operation_CometFeedStoryAttachmentMatchRenderer_attachment":{"__dr":"CometFeedStoryPhotoAttachmentStyle_styleTypeRenderer$normalization.graphql"},"__module_component_CometFeedStoryAttachmentMatchRenderer_attachment":{"__dr":"CometFeedStoryPhotoAttachmentStyle.react"}}}],"future_of_feed_info":{"should_reverse_message_and_attachment_position":false,"should_overlay_header":false,"aspect_ratio_update":-1,"web_reshare_variant":"NORMAL"},"attached_story":null,"bumpers":null,"comet_sections":{"__typename":"CometStorySections","content":{"__typename":"CometFeedStoryDefaultContentStrategy","__isICometStorySection":"CometFeedStoryDefaultContentStrategy","is_prod_eligible":true,"story":{"feedback":{"id":"ZmVlZGJhY2s6MTQ1OTQxMTMxOTMzNTc1Ng=="},"comet_sections":{"above_message":null,"seo_llm_title":null,"info_icon":null,"attachment_overlay":null,"attached_story":null,"message":{"__typename":"CometFeedStoryDefaultMessageRenderingStrategy","__isICometStorySection":"CometFeedStoryDefaultMessageRenderingStrategy","is_prod_eligible":true,"story":{"id":"","th_dat_spo":null,"url":"https:\/\/www.facebook.com\/cambongda\/posts\/pfbid02o1r3DLv6sxQQG5RzwF2XLu8RyibbPrn572t2shQGNxiQ9pRuPXKVFEumNuW4THBKl","feedback":{"id":"ZmVlZGJhY2s6MTQ1OTQxMTMxOTMzNTc1Ng=="},"is_text_only_story":false,"message":{"delight_ranges":[],"image_ranges":[],"inline_style_ranges":[],"aggregated_ranges":[],"ranges":[],"color_ranges":[],"text":"\ud83c\udde7\ud83c\uddf7 ZKRAKEN V\u00c0 C\u00c1I T\u00caN \u0110\u1eb6C BI\u1ec6T D\u00c0NH CHO HIMASS \ud83d\udc9a\ud83d\udc9b\n\nKh\u00f4ng c\u1ea7n m\u1ed9t b\u00e0i \u0111\u0103ng d\u00e0i, tuy\u1ec3n th\u1ee7 PUBG Brazil zkrakeN, nh\u00e0 v\u00f4 \u0111\u1ecbch Nations Cup 2026, ch\u1ec9 \u0111\u01a1n gi\u1ea3n \u0111\u1ed5i t\u00ean th\u00e0nh \u201cHimassPJL\u201d.\n\nNh\u01b0ng 4 ch\u1eef c\u00e1i ph\u00eda sau l\u1ea1i kh\u00f4ng h\u1ec1 ng\u1eabu nhi\u00ean.\nPJL l\u00e0 vi\u1ebft t\u1eaft c\u1ee7a Paz, Justica e Liberdade ngh\u0129a l\u00e0 H\u00d2A B\u00ccNH- C\u00d4NG L\u00dd - T\u1ef0 DO trong ti\u1ebfng B\u1ed3 \u0110\u00e0o Nha.\n\nM\u1ed9t c\u00e1i t\u00ean m\u1edbi, m\u1ed9t c\u00e1ch th\u1ec3 hi\u1ec7n r\u1ea5t ri\u00eang. zkrakeN d\u00f9ng ch\u00ednh nickname c\u1ee7a m\u00ecnh \u0111\u1ec3 g\u1eedi th\u00f4ng \u0111i\u1ec7p \u1ee7ng h\u1ed9 Himass, \u0111\u1ed3ng th\u1eddi nh\u1eafc \u0111\u1ebfn nh\u1eefng \u0111i\u1ec1u m\u00e0 anh mu\u1ed1n h\u01b0\u1edbng t\u1edbi: h\u00f2a b\u00ecnh, c\u00f4ng l\u00fd v\u00e0 t\u1ef1 do.\n\n\u0110\u00f4i khi, s\u1ef1 \u1ee7ng h\u1ed9 kh\u00f4ng c\u1ea7n qu\u00e1 nhi\u1ec1u l\u1eddi. Ch\u1ec9 m\u1ed9t l\u1ea7n \u0111\u1ed5i t\u00ean c\u0169ng \u0111\u1ee7 \u0111\u1ec3 ng\u01b0\u1eddi kh\u00e1c hi\u1ec3u b\u1ea1n \u0111ang \u0111\u1ee9ng \u1edf \u0111\u00e2u. \ud83d\udc9a\ud83d\udc9b"},"message_truncation_line_limit":2,"permalink_url":"https:\/\/www.facebook.com\/cambongda\/posts\/pfbid02o1r3DLv6sxQQG5RzwF2XLu8RyibbPrn572t2shQGNxiQ9pRuPXKVFEumNuW4THBKl","attachments":[{"action_links":[{"__typename":"MMEMessengerActionLink","url":"http:\/\/m.me\/cambongda"}],"source":null}]},"__module_operation_CometFeedStoryMessageMatchRenderer_story":{"__dr":"CometFeedStoryDefaultMessageRenderingStrategy_message$normalization.graphql"},"__module_component_CometFeedStoryMessageMatchRenderer_story":{"__dr":"CometFeedStoryDefaultMessageRenderingStrategy.react"}},"message_suffix":null,"message_container":{"__typename":"CometFeedStoryMessageContainerRenderingStrategy","__isICometStorySection":"CometFeedStoryMessageContainerRenderingStrategy","is_prod_eligible":true,"story":{"message":{"text":"\ud83c\udde7\ud83c\uddf7 ZKRAKEN V\u00c0 C\u00c1I T\u00caN \u0110\u1eb6C BI\u1ec6T D\u00c0NH CHO HIMASS \ud83d\udc9a\ud83d\udc9b\n\nKh\u00f4ng c\u1ea7n m\u1ed9t b\u00e0i \u0111\u0103ng d\u00e0i, tuy\u1ec3n th\u1ee7 PUBG Brazil zkrakeN, nh\u00e0 v\u00f4 \u0111\u1ecbch Nations Cup 2026, ch\u1ec9 \u0111\u01a1n gi\u1ea3n \u0111\u1ed5i t\u00ean th\u00e0nh \u201cHimassPJL\u201d.\n\nNh\u01b0ng 4 ch\u1eef c\u00e1i ph\u00eda sau l\u1ea1i kh\u00f4ng h\u1ec1 ng\u1eabu nhi\u00ean.\nPJL l\u00e0 vi\u1ebft t\u1eaft c\u1ee7a Paz, Justica e Liberdade ngh\u0129a l\u00e0 H\u00d2A B\u00ccNH- C\u00d4NG L\u00dd - T\u1ef0 DO trong ti\u1ebfng B\u1ed3 \u0110\u00e0o Nha.\n\nM\u1ed9t c\u00e1i t\u00ean m\u1edbi, m\u1ed9t c\u00e1ch th\u1ec3 hi\u1ec7n r\u1ea5t ri\u00eang. zkrakeN d\u00f9ng ch\u00ednh nickname c\u1ee7a m\u00ecnh \u0111\u1ec3 g\u1eedi th\u00f4ng \u0111i\u1ec7p \u1ee7ng h\u1ed9 Himass, \u0111\u1ed3ng th\u1eddi nh\u1eafc \u0111\u1ebfn nh\u1eefng \u0111i\u1ec1u m\u00e0 anh mu\u1ed1n h\u01b0\u1edbng t\u1edbi: h\u00f2a b\u00ecnh, c\u00f4ng l\u00fd v\u00e0 t\u1ef1 do.\n\n\u0110\u00f4i khi, s\u1ef1 \u1ee7ng h\u1ed9 kh\u00f4ng c\u1ea7n qu\u00e1 nhi\u1ec1u l\u1eddi. Ch\u1ec9 m\u1ed9t l\u1ea7n \u0111\u1ed5i t\u00ean c\u0169ng \u0111\u1ee7 \u0111\u1ec3 ng\u01b0\u1eddi kh\u00e1c hi\u1ec3u b\u1ea1n \u0111ang \u0111\u1ee9ng \u1edf \u0111\u00e2u. \ud83d\udc9a\ud83d\udc9b"},"referenced_sticker":null,"attachments":[{"style_list":["photo","fallback"]}],"text_format_metadata":null,"comet_sections":{"message":null},"id":""},"__module_operation_CometFeedStoryMessageContainerMatchRenderer_story":{"__dr":"CometFeedStoryMessageContainerRenderingStrategy_messageContainer$normalization.graphql"},"__module_component_CometFeedStoryMessageContainerMatchRenderer_story":{"__dr":"CometFeedStoryMessageContainerRenderingStrategy.react"}},"message_sticker":null,"aggregated_stories":null},"encrypted_tracking":"AZhj0A90abO9xSPHlbn27r2j1tGsdesQKsC8ezkLtX6muLg2yCqScH6ltj3kk2wGVky2j6jGilbtqBXyZh1t-2vr-Icm57L-UBntNNUD66vLRQz_tC7EC5_n3Nd85_NDkVPCNBiCkXpzC45VQsoAXptH5hM9t6IZf9LX-CHqKYKke8Y4w9wQcumF3FjGB8hJogbJJnF61j7WAfOWTuyx-IZhdWAc9DrfIcxM_wGUqCFKwNdNGG7KuIUf_fDatsb8QAgGGHTCkzKu5GN887zwJUzEyTkE3DQvc_PRJJlB3p4msJeAmeMtEVZAo3iVp3LONpddTYbytO5z_K3z8VBss899YWRKSH4kPpLkckpxrJ3emwgMjvc7IsrGiqVJ06b1EznmX3La7oS-