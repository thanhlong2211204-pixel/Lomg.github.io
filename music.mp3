4ng l\u00e0m nh\u1eefng chuy\u1ec7n kh\u00f4ng \u0111\u00fang \u0111\u1eafn nh\u01b0 v\u1eady n\u1eefa v\u00e0 s\u1ebd kh\u00f4ng c\u00f2n li\u00ean quan g\u00ec \u0111\u1ebfn Six n\u1eefa.\n\n\u0110\u00e2y c\u0169ng l\u00e0 l\u1ea7n cu\u1ed1i m\u00ecnh chia s\u1ebb v\u1ea5n \u0111\u1ec1 ri\u00eang t\u01b0 n\u00e0y v\u00e0 s\u1ebd c\u1ed1 g\u1eafng t\u1eadp trung ho\u00e0n thi\u1ec7n ph\u00e1t tri\u1ec3n b\u1ea3n th\u00e2n trong th\u1eddi gian t\u1edbi. Xin l\u1ed7i \u0111\u00e3 l\u00e0m cho ai y\u00eau m\u1ebfn m\u00ecnh th\u1ea5t v\u1ecdng , hy v\u1ecdng m\u1ecdi ng\u01b0\u1eddi s\u1ebd cho m\u00ecnh th\u1eddi gian."},"referenced_sticker":null,"attachments":[],"text_format_metadata":null,"comet_sections":{"message":null},"id":"UzpfSTEwMDA0NjcyMTc4MTE2MDoxNjQ1MDA0MzgzNzMzNjA1OjE2NDUwMDQzODM3MzM2MDU="},"__module_operation_CometFeedStoryMessageContainerMatchRenderer_story":{"__dr":"CometFeedStoryMessageContainerRenderingStrategy_messageContainer$normalization.graphql"},"__module_component_CometFeedStoryMessageContainerMatchRenderer_story":{"__dr":"CometFeedStoryMessageContainerRenderingStrategy.react"}},"message_sticker":null,"aggregated_stories":null},"encrypted_tracking":"AZjmqqwhwNcKqWopHhW8yZYSXINicRfiopkeX9lAnhVjesm6jnH1hBbHvQpagt93FASIhlk6N801NBAJ4hDS2ZSEoC0oeNUZsYzs1MrZeL65jvF5KYevZDwpzNf9FWQg8RKb9u-l_NsyhgDmHSi9jyDoFiJcxam97LCgmBGaG1BfbgK7SnibqUgtrzAiObMuvNL_1iq_JB15EHzFyX9RoOZGXeshLR1-RaL3sNuhS_lbK_UiZlYpghndLWhd-d6vTRaRzhrapb5lqh7fIKXbaRta1-_4Q34aHuN-sBPp6OiEg9rImUFQ0ajQX3AbD7WSVVV8Eg3lz2FmFSvLWszxwWcDW85VEG_NB2Gro__Dv7VOsPGxLgHHDoGUXObrLHQcObi_9PQhscOGy1LKmtAHwfVi53IAJWQZ6iKyb4e1BVnqIJdwHZeYo8YOTQtBkZQefIGR8P_nQPAbQu9ZE6wx2Jlg8rHfcEaXN_9d8I-8M2g4JJZvNlUusuNvIKGuMB_OXfWSrjprk5_WtWbyRHxppSyTy3LK7y-aMgLSKlNE__R6d38g3ZIFVZC4kicoGP1Hnstgj2c7UsCHdu2RDUdIWyQh71i724LN2iIBJgjXk16gakRcIoBPbqXPPtLNCpwU9lw8sR12s-oW6Jg_2q-0OOCPYakcfwd5G29tNCCBEzAvaAP7tmOu0I1RuMvK2bEAI8W1ut1z60b5NcMGYiuL5Fhzi0fBYVIcFt66a_2j_Y51cEYhNyrBAmndugP3AMhkDe_BALbjLoukTw91StluHKaRUGHmpwtIhK75Z3FG